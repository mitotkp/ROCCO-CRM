# ── Servidor ─────────────────────────────────────────────────────────────────
# IP o dominio del servidor (sin https://, sin puerto)
SERVER_HOST=192.168.0.123

# URL pública completa del CRM (la que ven los usuarios / webhooks externos)
PUBLIC_URL=http://192.168.0.123:3100

# ── Base de datos ─────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=cambia_esto_por_una_password_segura

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio

# ── Cifrado de credenciales de terceros en la BD (obligatoria) ───────────────
# 32 bytes en base64: openssl rand -base64 32. Sin ella el servidor no arranca.
# Guárdala también fuera del servidor: sin la clave no se pueden leer los tokens ya cifrados.
SECRETS_KEY=

# ── Registro público (opcional) ──────────────────────────────────────────────
# Cerrado por defecto: las cuentas se crean desde el panel de agencia.
ALLOW_PUBLIC_SIGNUP=false

# ── Evolution API (WhatsApp) ──────────────────────────────────────────────────
# URL y clave de API del Evolution del servidor: ahí se crean las instancias de cada cliente
EVOLUTION_URL=http://IP_DEL_SERVIDOR:8080
EVOLUTION_API_KEY=cambia_esto_por_la_clave_de_tu_evolution

# ── Meta / Facebook / Instagram (opcional) ───────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# El webhook rechaza lo que no venga firmado con META_APP_SECRET o INSTAGRAM_APP_SECRET.
# false = modo observación (se procesa igual): solo para depurar.
META_WEBHOOK_ENFORCE_SIGNATURE=true
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# ── Google Calendar / Meet (opcional) ────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Zoom (opcional) ───────────────────────────────────────────────────────────
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# ── Alertas operativas (opcional) ────────────────────────────────────────────
# Errores del servidor y caídas de WhatsApp: a un webhook (p. ej. n8n) o directo a Telegram
ALERT_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
